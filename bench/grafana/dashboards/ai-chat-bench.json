{
  "uid": "ai-chat-bench",
  "title": "AI 채팅 A(Tomcat) vs B(WebFlux)",
  "tags": [
    "sudaduck",
    "bench"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": false,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": false,
        "hide": true,
        "iconColor": "#c2410c",
        "name": "기존 서버 측정 구간",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [
            "기존"
          ],
          "type": "tags"
        }
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": false,
        "hide": true,
        "iconColor": "#1d4ed8",
        "name": "개선 서버 측정 구간",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [
            "개선"
          ],
          "type": "tags"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "초당 처리 요청 (기존 vs 개선)",
      "description": "AI 채팅 API(/api/v1/ai-chat/**) 처리 완료 건수의 초당 비율.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "duckduck-tomcat"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "기존 (톰캣, @Async)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "chat-webflux"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "개선 (WebFlux)"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{uri=~\"/api/v1/ai-chat.*\"}[30s]))",
          "legendFormat": "{{application}}",
          "range": true
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "응답 시간 p95 (서버 측)",
      "description": "http_server_requests 히스토그램 기준 p95. SSE 는 측정 시점이 다를 수 있다: A(SseEmitter)는 비동기 처리 완료까지, B 는 응답 스트림 완료까지. 사용자 체감 값은 k6 결과를 본다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "duckduck-tomcat"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "기존 (톰캣, @Async)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "chat-webflux"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "개선 (WebFlux)"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (application, uri, le) (rate(http_server_requests_seconds_bucket{uri=~\"/api/v1/ai-chat.*\"}[30s])))",
          "legendFormat": "{{application}} {{uri}}",
          "range": true
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "톰캣 스레드 (A)",
      "description": "A 의 요청 처리 스레드. busy 가 max 에 붙으면 새 요청은 대기한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
